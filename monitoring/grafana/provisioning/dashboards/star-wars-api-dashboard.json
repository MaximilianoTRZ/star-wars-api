    {
      "type": "timeseries",
      "id": 10,
      "title": "Queries by resource and channel",
      "description": "Catalog listings per second, split by resource and by channel (REST or GraphQL).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (resource, channel) (rate(catalog_queries_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{resource}} · {{channel}}"
