    {
      "type": "stat",
      "id": 33,
      "title": "SwapiCircuitOpen",
      "description": "Same condition as the SwapiCircuitOpen rule in monitoring/alerts.yml: the SWAPI circuit breaker is open. Shows the current state; Prometheus also waits 1 minute before firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(resilience4j_circuitbreaker_state{name=\"swapi\", state=\"open\"}) == bool 1",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
