    {
      "type": "stat",
      "id": 34,
      "title": "HighServerErrorRate",
      "description": "Same condition as the HighServerErrorRate rule in monitoring/alerts.yml: more than 5% of API responses are 5xx over 5 minutes. Shows the current state; Prometheus also waits 5 minutes before firing.",
