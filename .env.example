# Copy this file to .env and fill in real values. Never commit .env.
JWT_SECRET=change-me-to-a-secret-of-at-least-32-bytes
# Only while rotating JWT_SECRET: the old value, so tokens it signed stay valid until they expire (ADR-020)
# JWT_PREVIOUS_SECRET=
DEMO_USER_PASSWORD=change-me
# prod only: credentials Grafana Cloud uses to scrape /actuator/prometheus (min 16 characters)
METRICS_USERNAME=grafana
METRICS_PASSWORD=change-me-at-least-16-chars
