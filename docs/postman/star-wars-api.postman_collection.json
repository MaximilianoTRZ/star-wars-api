{
  "info": {
    "_postman_id": "3f2a108a-aa50-5e68-b54a-ae180243e0ce",
    "name": "Star Wars API",
    "description": "Phase 1 flow. Run **Auth > Login** first (the collection runner does it in order): it stores the token used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "demo"
    },
    {
      "key": "password",
      "value": "demo123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "not-a-valid-token"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Bearer token\", () => pm.expect(body.tokenType).to.eql(\"Bearer\"));",
                  "pm.test(\"expires in 1 h\", () => pm.expect(body.expiresIn).to.eql(3600));",
                  "pm.collectionVariables.set(\"token\", body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "const problem = pm.response.json();",
                  "pm.test(\"ProblemDetail content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"type /problems/invalid-credentials\", () => pm.expect(problem.type).to.eql(\"/problems/invalid-credentials\"));",
                  "pm.test(\"has timestamp\", () => pm.expect(problem.timestamp).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - missing password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "const problem = pm.response.json();",
                  "pm.test(\"ProblemDetail content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"type /problems/validation-error\", () => pm.expect(problem.type).to.eql(\"/problems/validation-error\"));",
                  "pm.test(\"has timestamp\", () => pm.expect(problem.timestamp).to.be.a(\"string\"));",
                  "pm.test(\"password listed in errors\", () => pm.expect(problem.errors.map(e => e.field)).to.include(\"password\"));"
                ]
              }
            }
          ]
        }
      ]
    },
